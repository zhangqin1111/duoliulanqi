{
  "name": "duoliulanqi",
  "version": "0.1.0",
  "private": true,
  "description": "滤镜 - 多源大模型内容对比与分析系统",
  "main": "src/electron/main.js",
  "author": "",
  "scripts": {
    "start": "electron .",
    "prebuild:clean": "node scripts/prebuild-clean.js",
    "postbuild:summary": "node scripts/postbuild-summary.js",
    "dist": "npm run prebuild:clean && electron-builder --win --x64 && npm run postbuild:summary",
    "dist:portable": "npm run prebuild:clean && electron-builder --win portable --x64 && npm run postbuild:summary",
    "dist:installer": "npm run prebuild:clean && electron-builder --win nsis --x64 && npm run postbuild:summary",
    "dist:dir": "electron-builder --win --x64 --dir",
    "license:keygen": "node scripts/license-keygen.js",
    "license:issue": "node scripts/license-issue.js",
    "license:batch": "node scripts/license-batch.js",
    "check:routing": "node scripts/check-task-routing.js",
    "check:report-schema": "node scripts/check-report-schema.js",
    "check:report-repair": "node scripts/check-report-json-repair.js",
    "check:analysis-state": "node scripts/check-analysis-state.js",
    "check:question-refine": "node scripts/check-question-refinement-policy.js",
    "check:ai-provider": "node scripts/check-ai-provider.js",
    "check:provider-completion": "node scripts/check-provider-completion.js",
    "check:api-only": "node scripts/check-api-only-runner.js",
    "check:evidence": "node scripts/check-evidence-layer.js",
    "check:high-risk": "node scripts/check-high-risk.js",
    "check:license": "node scripts/check-license.js",
    "check:commercial-support": "node scripts/check-commercial-support.js",
    "check:scenario-templates": "node scripts/check-scenario-templates.js",
    "check:scenario-contracts": "node scripts/check-scenario-json-contracts.js",
    "check:report-completeness": "node scripts/check-report-completeness-orchestrator.js",
    "render:report-fixtures": "node scripts/render-report-fixtures.js",
    "check:report-visual": "node scripts/report-visual-regression.js",
    "check:report-layout": "node scripts/check-report-layout.js",
    "check:report-outcome": "node scripts/check-report-outcome-quality.js",
    "check:commercial-readiness": "npm run check:routing && npm run check:report-schema && npm run check:report-repair && npm run check:analysis-state && npm run check:question-refine && npm run check:ai-provider && npm run check:provider-completion && npm run check:api-only && npm run check:evidence && npm run check:high-risk && npm run check:license && npm run check:commercial-support && npm run check:scenario-templates && npm run check:scenario-contracts && npm run check:report-completeness && npm run render:report-fixtures && npm run check:report-layout && npm run check:report-outcome && npm run check:report-visual",
    "deck:assets": "node scripts/render-chart-pngs.js",
    "deck:word": "node scripts/generate-investor-deck.js",
    "deck:ppt": "node scripts/generate-investor-ppt.js",
    "deck:all": "node scripts/render-chart-pngs.js && node scripts/generate-investor-deck.js && node scripts/generate-investor-ppt.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.6.1",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "pptxgenjs": "^4.0.1"
  },
  "build": {
    "appId": "com.local.lvjing",
    "productName": "滤镜",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/**/*"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "lvjing"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "shortcutName": "滤镜"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.exe"
    }
  }
}
